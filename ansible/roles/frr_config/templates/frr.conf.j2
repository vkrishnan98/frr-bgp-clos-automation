! Generated by Ansible for {{ inventory_hostname }} — do not hand-edit
!
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
!
interface lo
 ip address {{ loopback }}/32
!
{% if role == 'leaf' %}
interface {{ access_interface }}
 ip address {{ access_network | ipaddr('1') }}
!
{% endif %}
{% if role == 'leaf' and ospf_area is defined and ospf_area %}
interface {{ ospf_interface }}
 ip address {{ ospf_link_ip }}
 ip ospf area {{ ospf_area }}
 ip ospf network point-to-point
!
{% endif %}
{% if role == 'edge' %}
interface {{ ospf_interface }}
 ip address {{ ospf_link_ip }}
 ip ospf area {{ ospf_area }}
 ip ospf network point-to-point
!
{% endif %}
!
{% if role == 'leaf' and ospf_area is defined and ospf_area %}
router ospf
 ospf router-id {{ loopback }}
 ! interface-level "ip ospf area" above is sufficient; no network statement needed
 redistribute bgp route-map FABRIC-TO-WAN
!
{% endif %}
{% if role == 'edge' %}
router ospf
 ospf router-id {{ loopback }}
 redistribute static route-map WAN-TO-FABRIC
!
{% endif %}
{% if role == 'edge' %}
ip route {{ wan_network }} Null0
!
{% endif %}
!
router bgp {{ local_asn }}
 bgp router-id {{ loopback }}
 no bgp ebgp-requires-policy
{% for iface in bgp_unnumbered_interfaces %}
 neighbor {{ iface }} interface remote-as external
{% endfor %}
{% if role == 'edge' %}
 neighbor {{ ospf_interface }} interface remote-as {{ peer_asn }}
{% endif %}
 !
 address-family ipv4 unicast
  network {{ loopback }}/32
{% if role == 'leaf' %}
  network {{ access_network }}
{% endif %}
{% if role == 'edge' %}
  network {{ wan_network }}
  redistribute ospf route-map WAN-TO-FABRIC
{% endif %}
{% for iface in bgp_unnumbered_interfaces %}
  neighbor {{ iface }} soft-reconfiguration inbound
{% endfor %}
 exit-address-family
!
ip prefix-list PL-FABRIC-SUPERNET seq 10 permit {{ fabric_advertised_supernet }} le 32
ip prefix-list PL-WAN-SUPERNET seq 10 permit {{ wan_advertised_supernet }} le 32
!
route-map WAN-TO-FABRIC permit 10
 match ip address prefix-list PL-WAN-SUPERNET
!
route-map FABRIC-TO-WAN permit 10
 match ip address prefix-list PL-FABRIC-SUPERNET
!
line vty
!
